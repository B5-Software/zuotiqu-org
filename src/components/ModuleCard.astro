---
import type { SiteModule } from '../config/modules';

interface Props {
  module: SiteModule;
}

const { module } = Astro.props;
const isLive = module.status === 'live';
---

<a class="card" href={module.href} aria-disabled={!isLive} target={module.external ? '_blank' : undefined} rel={module.external ? 'noopener noreferrer' : undefined}>
  <h3>{module.title}</h3>
  <p class="muted">{module.summary}</p>
  <span class="tag">{module.external ? '前往游戏 ↗' : isLive ? '开放' : '施工中'}</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.1s ease;
  }

  .card:hover {
    transform: translateY(-2px) rotate(-0.4deg);
    color: var(--ink);
  }

  .card h3 {
    margin: 0;
  }

  .card p {
    margin: 0;
    flex: 1;
  }
</style>
