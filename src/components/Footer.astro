---
import { site, disclaimers } from '../config/site';
---

<footer class="site-footer">
  <div class="inner">
    <p class="privacy">{disclaimers.privacy}</p>
    <p class="links">
      <a href="/about">关于与致谢</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">隐私说明</a>
      <span aria-hidden="true">·</span>
      <a href={site.repoUrl}>源代码</a>
    </p>
    <p class="license">
      代码以 {site.license.code} 许可发布；词条、文案与图像以 {site.license.content} 放弃版权。
      本站为整活作品，与任何学校、考试机构无关。
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1.5px solid var(--ink);
    background: var(--card);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: var(--space-4);
  }

  p {
    margin: var(--space-1) 0;
  }

  .links a {
    color: var(--ink-soft);
  }
</style>
