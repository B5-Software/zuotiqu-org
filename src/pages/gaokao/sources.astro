---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sources from '../../data/gaokao-sources.json';

const modeNames: Record<string, string> = {
  '3+3': '3+3',
  '3+1+2': '3+1+2',
  '传统高考': '传统高考',
};
---

<BaseLayout
  title="全国31省高考数据与志愿填报官方资料"
  description="2026年全国31省级招考机构入口、官方一分一段表、部分投档表与2027选科要求；所有条目注明来源与覆盖程度。"
>
  <header class="page-head">
    <h1>全国志愿资料库 · 官方来源</h1>
    <p class="lead">
      整理中国内地31个省级招考机构、教育部高校名单、2026年分数段及投档资料。先查<strong>生源省</strong>，再查院校计划；不是按大学所在地选省。
    </p>
    <div class="source-actions">
      <a class="btn" href="/gaokao">返回模拟志愿</a>
      <a class="btn" href="/gaokao/schools">院校检索（现为演示）</a>
    </div>
  </header>

  <div class="warn" role="note">
    <strong>数据边界：</strong>以下是已搜集的官方入口及部分直接资料，不等于已将全国院校历年投档记录导入本站。
    「全国汇总入口」表示尚未核对到该省单独的机读文件。<strong>当前本站推荐模块仍使用虚构演示数据，不得用于真实填报决策。</strong>
    2027年正式填报必须核实当年招生计划、专业组代码、选科要求、招生章程和省级官方系统。
  </div>

  <section class="panel national" aria-labelledby="national-title">
    <h2 id="national-title">全国共通的权威资料</h2>
    <div class="national-grid">
      {sources.national.map((s) => (
        <a class="national-link" href={s.url} target="_blank" rel="noopener noreferrer">
          <span class="tag">{s.kind}</span><strong>{s.title}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <p class="muted">官方目录和各省招考机构文件优先，媒体整理仅可作为线索；真实投档结果优先核对省级发布的原表。</p>
  </section>

  <section aria-labelledby="provinces-title" class="provinces-section">
    <h2 id="provinces-title">31省官方资料入口</h2>
    <div class="filters">
      <label class="field">
        <span>按省份或关键字搜索</span>
        <input type="search" id="source-search" placeholder="例如 陕西、山东、江苏" autocomplete="off"/>
      </label>
      <label class="field">
        <span>高考模式（按2026年普通类）</span>
        <select id="source-mode">
          <option value="">全部模式</option>
          <option value="3+1+2">3+1+2</option>
          <option value="3+3">3+3</option>
          <option value="传统高考">传统高考</option>
        </select>
      </label>
    </div>
    <p id="source-count" class="muted" aria-live="polite">共整理 {sources.provinces.length} 个地区，具体数据覆盖程度见各卡片。</p>
    <div class="province-grid" id="source-grid">
      {sources.provinces.map((p) => (
        <article class="province-card" data-province-card data-name={p.name} data-mode={p.examMode}>
          <div class="card-top">
            <h3>{p.name}</h3>
            <span class="tag">{modeNames[p.examMode]}</span>
          </div>
          <p class="muted small">{p.note}</p>
          <div class="links">
            <a href={p.officialUrl} target="_blank" rel="noopener noreferrer">省级招考机构 ↗</a>
            <a href={p.rank2026Url} target="_blank" rel="noopener noreferrer">
              {p.rankLinkLevel === 'national-index' ? '2026分数段：全国汇总入口 ↗' : '2026分数段：官方入口 ↗'}
            </a>
            {p.admission2026Url && (
              <a href={p.admission2026Url} target="_blank" rel="noopener noreferrer">2026投档／招生表 ↗</a>
            )}
            {p.code === 'SN' && <a href="/gaokao/ranks">陕西2026官方位次查询（已机读校验） ↗</a>}
            {p.code === 'SN' && <a href="https://www.sneea.cn/info/1027/17659.htm" target="_blank" rel="noopener noreferrer">陕西2026历史一分段 ↗</a>}
            {p.code === 'SC' && <a href="https://zyfz.sceeic.cn/" target="_blank" rel="noopener noreferrer">四川官方辅助填报 ↗</a>}
            {p.code === 'GX' && <a href="https://zyfz.gxeea.cn/" target="_blank" rel="noopener noreferrer">广西官方辅助填报 ↗</a>}
            {p.code === 'NX' && <a href="https://baoming.nxjyks.cn/zyfz/" target="_blank" rel="noopener noreferrer">宁夏官方辅助填报 ↗</a>}
            {p.code === 'GS' && <a href="https://yggk.ganseea.cn/login" target="_blank" rel="noopener noreferrer">甘肃官方辅助填报 ↗</a>}
          </div>
        </article>
      ))}
    </div>
    <p class="muted small">数据源索引核查日期：{sources.meta.version}。部分招生计划需要招生考试机构账号登录或通过官方出版物获取，不会通过虚构数据补齐。</p>
  </section>

  <section class="panel" aria-labelledby="guidance-title">
    <h2 id="guidance-title">怎样才算“真实能用”的志愿推荐？</h2>
    <ol>
      <li>按本省当年一分一段表取得<strong>对应科类或首选科目的真实位次</strong>。</li>
      <li>汇总近三年同省、同批次、同院校专业组／专业的最低投档位次，不跨省直接比。</li>
      <li>匹配目标年份的<strong>真实招生计划与选科要求</strong>；计划变化和专业组重组应标记不可简单纵比。</li>
      <li>逐个检查招生章程涉及的体检限制、单科要求、外语语种、收费、校区、专业调剂规则。</li>
      <li>显示每条依据的原始来源、年份与缺失字段；没有足够数据就显示「无法判断」，绝不伪造录取概率。</li>
      <li>本站只辅助研究与模拟排序；最终志愿必须由考生在所属省官方系统亲自填报。</li>
    </ol>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#source-search');
  const mode = document.querySelector<HTMLSelectElement>('#source-mode');
  const count = document.querySelector<HTMLElement>('#source-count');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-province-card]'));

  function filterCards() {
    const q = (search?.value || '').trim().toLocaleLowerCase();
    const m = mode?.value || '';
    let visible = 0;
    for (const card of cards) {
      const matches = (!q || (card.dataset.name || '').toLocaleLowerCase().includes(q))
        && (!m || card.dataset.mode === m);
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (count) count.textContent = '符合条件：' + visible + ' / ' + cards.length + ' 个地区';
  }
  search?.addEventListener('input', filterCards);
  mode?.addEventListener('change', filterCards);
</script>

<style>
  .page-head { margin-bottom: var(--space-4); }
  .source-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .national, .provinces-section { margin-top: var(--space-6); }
  .national h2 { margin-top: 0; }
  .national-grid { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .national-link { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--paper); padding: var(--space-3); text-decoration: none; }
  .national-link span:last-child { margin-left: auto; }
  .national-link:hover, .province-card a:hover { color: var(--blue); }
  .filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3); margin: var(--space-3) 0; }
  .field { display: grid; gap: var(--space-1); font-weight: 600; }
  .field input, .field select { min-height: 44px; min-width: 0; width: 100%; max-width: 100%; padding: var(--space-2) var(--space-3); font: inherit; color: var(--ink); background: var(--card); border: 1.5px solid var(--ink); border-radius: var(--radius-sm); }
  .province-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 275px), 1fr)); gap: var(--space-3); }
  .province-card { min-width: 0; padding: var(--space-3) var(--space-4); background: var(--card); border: 1.5px solid var(--ink); border-radius: var(--radius); }
  .province-card[hidden] { display: none; }
  .card-top { display: flex; align-items: center; gap: var(--space-2); justify-content: space-between; }
  .card-top h3 { margin: 0; }
  .small { font-size: 0.9rem; }
  .province-card .small { margin: var(--space-2) 0; }
  .links { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); overflow-wrap: anywhere; }
  .links a { min-height: 33px; padding: 2px 0; }
</style>
